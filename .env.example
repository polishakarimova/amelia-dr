PORT=3000
HOST=127.0.0.1
APP_URL=http://127.0.0.1:3000
DATA_DIR=./data

# PostgreSQL is optional locally. Without it the app uses DATA_DIR/db.json.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PGSSLROOTCERT=

# Admin UI: /admin?adminToken=...
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Optional marketplace preview provider.
# Required for Ozon when the server IP is blocked by Ozon antibot.
# The endpoint must accept ?url=<product-url> or include a {url} placeholder.
# Expected JSON: {"title":"...", "price":1234, "image":"https://..."}
GIFT_PREVIEW_PROXY_URL=
OZON_PREVIEW_PROXY_URL=
SCRAPINGBEE_API_KEY=
ZENROWS_API_KEY=
SCRAPERAPI_KEY=

# Telegram integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
